<%- include('partials/header') %><main class="page-main"><section class="page-hero"><div class="container"><span class="section-kicker">We are here to help</span><h1>Contact Shilptara</h1><p>Ask about products, customisation, flower preservation, delivery or bulk gifting.</p></div></section><section class="section container contact-grid"><div class="contact-card"><h2>Get in touch</h2><p><b>Email</b><br><a href="mailto:<%= site.contact_email %>"><%= site.contact_email %></a></p><p><b>Phone</b><br><%= site.contact_phone %></p><p><b>Location</b><br><%= site.address %></p><p><b>Custom orders</b><br>Share reference images and details through WhatsApp for faster discussion.</p></div><form class="form-card" method="post" action="/contact"><h2>Send a message</h2><div class="form-grid two"><label>Name<input class="field" name="name" required></label><label>Email<input class="field" type="email" name="email" required></label><label>Phone<input class="field" name="phone"></label><label>Subject<input class="field" name="subject"></label><label class="span-2">Message<textarea class="field" name="message" rows="6" required></textarea></label></div><button class="btn btn-primary" type="submit">Send Message</button></form></section></main><%- include('partials/footer') %>
