<%- include('partials/header') %>
<main class="page-main"><section class="page-hero mini"><div class="container"><h1>Your Cart</h1></div></section><section class="container cart-layout">
  <div class="cart-items"><% if(items.length){ items.forEach(item=>{ %><article class="cart-item"><a href="/product/<%= item.slug %>"><img src="/media/product/<%= item.image_id %>" alt="<%= item.name %>"></a><div class="cart-item-info"><small><%= item.category_name %></small><h3><a href="/product/<%= item.slug %>"><%= item.name %></a></h3><strong><%= money(item.price) %></strong><form method="post" action="/cart/update" class="inline-form"><input type="hidden" name="product_id" value="<%= item.id %>"><input class="qty-small" type="number" name="qty" min="1" max="10" value="<%= item.qty %>"><button class="text-link" type="submit">Update</button></form><form method="post" action="/cart/remove"><input type="hidden" name="product_id" value="<%= item.id %>"><button class="remove-link" type="submit">Remove</button></form></div><b class="line-total"><%= money(item.line_total) %></b></article><% }) } else { %><div class="empty-state"><h2>Your cart is empty</h2><p>Browse handcrafted pieces and save something meaningful.</p><a class="btn btn-primary" href="/shop">Continue Shopping</a></div><% } %></div>
  <% if(items.length){ %><aside class="order-summary"><h2>Order Summary</h2><div><span>Subtotal</span><b><%= money(subtotal) %></b></div><% if(discount>0){ %><div><span>Discount (<%= couponCode %>)</span><b>-<%= money(discount) %></b></div><% } %><div><span>Shipping</span><b><%= shipping===0?'FREE':money(shipping) %></b></div><div class="summary-total"><span>Total</span><b><%= money(total) %></b></div><form method="post" action="/cart/coupon" style="display:grid;grid-template-columns:1fr auto;gap:8px;margin:12px 0"><input class="field" name="coupon_code" placeholder="Coupon code" value="<%= couponCode %>"><button class="btn btn-ghost" type="submit"><%= couponCode?'Update':'Apply' %></button></form><p>Try <b>WELCOME10</b> for 10% off. Free shipping above ₹1,499.</p><a class="btn btn-primary btn-block" href="/checkout">Proceed to Checkout</a><a class="btn btn-ghost btn-block" href="/shop">Continue Shopping</a></aside><% } %>
</section></main><%- include('partials/footer') %>
