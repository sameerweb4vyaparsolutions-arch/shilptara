<%- include('partials/header') %><main class="page-main celebrity-gallery-page"><section class="page-hero"><div class="container gallery-page-intro"><span class="section-kicker">Special moments</span><h1>Celebrity & Event Gallery</h1><p>Selected photos and videos from appearances, events and special Shilptara moments.</p></div></section><section class="section container"><% if(items.length){ %><div class="celebrity-grid"><% items.forEach(item=>{ %><article class="celebrity-card"><div class="celebrity-media-frame"><% if(String(item.mime_type||'').startsWith('video/')){ %><video src="/media/celebrity/<%= item.id %>" controls preload="metadata" playsinline></video><% } else { %><img src="/media/celebrity/<%= item.id %>" alt="<%= item.title %>" loading="lazy"><% } %></div><div class="celebrity-card-copy"><h3><%= item.title %></h3><% if(item.caption){ %><p><%= item.caption %></p><% } %></div></article><% }) %></div><% } else { %><div class="empty-state"><h2>Gallery coming soon</h2><p>New photos and videos will appear here when added from the admin panel.</p></div><% } %></section></main><%- include('partials/footer') %>
