<%- include('partials/header') %><main class="page-main"><section class="success-page container"><div class="success-icon">✓</div><span class="section-kicker">Order confirmed</span><h1>Thank you for your order</h1><p>Your order number is <b><%= order.order_number %></b>. Keep it for reference.</p><div class="success-card"><div><span>Order total</span><b><%= money(order.total) %></b></div><div><span>Payment</span><b><%= order.payment_method %></b></div><div><span>Status</span><b><%= order.order_status %></b></div><div><span>Delivery to</span><b><%= order.city %>, <%= order.state %></b></div></div><div class="success-actions"><a class="btn btn-primary" href="/shop">Continue Shopping</a><a class="btn btn-ghost" href="/contact">Contact Us</a></div></section></main><%- include('partials/footer') %>
