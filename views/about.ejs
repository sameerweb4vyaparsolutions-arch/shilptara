<%- include('partials/header') %>
<main class="page-main">
  <section class="page-hero"><div class="container"><span class="section-kicker">Our story</span><h1>Nature, memory & handmade detail</h1><p><%= site.about_text %></p></div></section>
  <section class="section container about-grid"><div><span class="section-kicker">Shilptara by Sonali</span><h2>Made to keep meaningful things close</h2><p>Our collection brings together preserved botanicals, resin, jewellery findings and personalised details. From a tiny flower inside a pendant to a wedding varmala preserved in a frame, the idea is simple: turn moments into objects you can keep.</p><p>Every handmade piece naturally varies in colour, texture and placement. Those small differences are part of the character of working with real flowers and hand-finished materials.</p><a class="btn btn-primary" href="/shop">Explore the Collection</a></div><div class="about-values"><article><b>01</b><h3>Botanical at heart</h3><p>Flowers, petals, leaves and nature-inspired forms guide the collection.</p></article><article><b>02</b><h3>Personal by design</h3><p>Names, dates, initials and memory flowers can be added to many pieces.</p></article><article><b>03</b><h3>Handmade in small batches</h3><p>Each piece is assembled and finished carefully rather than mass-produced.</p></article></div></section>

  <section class="section soft-bg"><div class="container"><div class="section-heading centered"><span class="section-kicker">What we create</span><h2>Explore our categories</h2><p>Jewellery, keepsakes, gifting and flower-preservation pieces, each with its own handmade character.</p></div><div class="category-scroller"><% categories.forEach(c=>{ %><a class="category-circle" href="/shop?category=<%= c.slug %>"><span><img src="/media/category/<%= c.id %>" alt="<%= c.name %>" loading="lazy" onerror="this.onerror=null;this.src='/seed-images/<%= c.slug %>/01.jpg';"></span><strong><%= c.name %></strong></a><% }) %></div></div></section>

  <% if(reviews.length){ %><section class="section container"><div class="section-heading centered"><span class="section-kicker">Customer stories</span><h2>Reviews from our customers</h2><p>Real feedback and shared photos or videos can appear here after customers submit a review.</p></div><div class="review-grid"><% reviews.forEach(r=>{ %><article><% if(r.media_id){ %><div class="review-media"><% if(String(r.media_type||'').startsWith('video/')){ %><video src="/media/review/<%= r.media_id %>" controls preload="metadata"></video><% } else { %><img src="/media/review/<%= r.media_id %>" alt="Customer review"><% } %></div><% } %><div class="stars"><%= '★'.repeat(r.rating) %></div><p>“<%= r.comment %>”</p><strong><%= r.reviewer_name %></strong><small><%= r.product_name %></small></article><% }) %></div></section><% } %>
</main>
<%- include('partials/footer') %>
