<%- include('head') %><%- include('sidebar') %><main class="admin-main"><div class="admin-top"><div><small>Product help</small><h1>Questions</h1></div></div><% if(flash){ %><div class="admin-flash <%= flash.type %>"><%= flash.message %></div><% } %><% if(questions.length){ questions.forEach(q=>{ %><article class="admin-panel question-card"><header><div><b><%= q.product_name %></b><small><%= q.name %> • <%= q.email %></small></div><small><%= new Date(q.created_at).toLocaleDateString('en-IN') %></small></header><p><b>Q:</b> <%= q.question %></p><form class="admin-form" method="post" action="/admin/questions/<%= q.id %>/answer"><label>Answer<textarea name="answer" rows="3" placeholder="Reply shown on product page"><%= q.answer || '' %></textarea></label><button class="admin-btn primary" type="submit">Save Answer</button></form><div class="actions" style="margin-top:10px"><form method="post" action="/admin/questions/<%= q.id %>/delete"><button data-confirm="Delete this question?" type="submit">Delete question</button></form></div></article><% }) } else { %><div class="admin-panel">No product questions yet.</div><% } %></main><%- include('foot') %>
