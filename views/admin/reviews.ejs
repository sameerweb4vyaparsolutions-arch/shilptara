<%- include('head') %><%- include('sidebar') %><main class="admin-main"><div class="admin-top"><div><small>Community</small><h1>Reviews</h1></div></div><% if(reviews.length){ reviews.forEach(r=>{ %><article class="admin-panel review-card"><header><div><b><%= r.product_name %></b><small><%= r.reviewer_name %> • <%= new Date(r.created_at).toLocaleDateString('en-IN') %></small></div><div><%= '★'.repeat(r.rating) %></div></header><p><%= r.comment %></p><% if(r.media_id){ %><div class="admin-review-media"><% if(String(r.media_type||'').startsWith('video/')){ %><video src="/media/review/<%= r.media_id %>" controls preload="metadata"></video><% } else { %><img src="/media/review/<%= r.media_id %>" alt="Review media"><% } %></div><% } %><div class="actions"><form method="post" action="/admin/reviews/<%= r.id %>/toggle"><button type="submit"><%= r.approved?'Hide':'Approve' %></button></form><form method="post" action="/admin/reviews/<%= r.id %>/delete"><button data-confirm="Delete this review?" type="submit">Delete</button></form></div></article><% }) } else { %><div class="admin-panel">No reviews yet.</div><% } %></main><%- include('foot') %>
