<%- include('head') %><%- include('sidebar') %><main class="admin-main"><div class="admin-top"><div><small>Overview</small><h1>Dashboard</h1></div><a class="admin-btn primary" href="/admin/products/new">+ Add Product</a></div><% if(flash){ %><div class="admin-flash <%= flash.type %>"><%= flash.message %></div><% } %><section class="stats-grid"><article><span>Products</span><b><%= stats.products.total %></b><a href="/admin/products">Manage →</a></article><article><span>Categories</span><b><%= stats.categories.total %></b><a href="/admin/categories">Manage →</a></article><article><span>Orders</span><b><%= stats.orders.total %></b><small>Revenue <%= money(stats.orders.revenue) %></small></article><article><span>Open Questions</span><b><%= stats.questions.total %></b><a href="/admin/questions">Reply →</a></article><article><span>Messages</span><b><%= stats.messages.total %></b><a href="/admin/messages">View →</a></article></section><section class="admin-grid-two"><div class="admin-panel"><div class="panel-head"><h2>Recent Orders</h2><a href="/admin/orders">View all</a></div><div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Total</th><th>Status</th></tr></thead><tbody><% orders.forEach(o=>{ %><tr><td><%= o.order_number %></td><td><%= o.customer_name %></td><td><%= money(o.total) %></td><td><span class="admin-status"><%= o.order_status %></span></td></tr><% }) %></tbody></table></div></div><div class="admin-panel"><div class="panel-head"><h2>Low Stock</h2><a href="/admin/products">Products</a></div><% if(lowStock.length){ lowStock.forEach(p=>{ %><div class="stock-row"><span><%= p.name %></span><b><%= p.stock %> left</b></div><% }) } else { %><p>No low-stock products.</p><% } %></div></section></main><%- include('foot') %>
