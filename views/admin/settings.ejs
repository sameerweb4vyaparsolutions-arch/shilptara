<%- include('head') %><%- include('sidebar') %><main class="admin-main"><div class="admin-top"><div><small>Website content</small><h1>Site Settings</h1></div></div><% if(flash){ %><div class="admin-flash <%= flash.type %>"><%= flash.message %></div><% } %><form class="admin-panel admin-form" method="post" action="/admin/settings"><div class="settings-grid"><label>Site name<input name="site_name" value="<%= settings.site_name || '' %>"></label><label>Announcement bar<input name="announcement" value="<%= settings.announcement || '' %>"></label><label>Contact email<input type="email" name="contact_email" value="<%= settings.contact_email || '' %>"></label><label>Contact phone<input name="contact_phone" value="<%= settings.contact_phone || '' %>" placeholder="+91..."></label><label>WhatsApp number<input name="whatsapp_number" value="<%= settings.whatsapp_number || '' %>" placeholder="91xxxxxxxxxx"></label><label>GST Number<input name="gst_number" value="<%= settings.gst_number || '' %>" placeholder="Enter GSTIN if applicable"></label><label>Address<input name="address" value="<%= settings.address || '' %>"></label><label>Instagram URL<input name="instagram_url" value="<%= settings.instagram_url || '' %>"></label><label>Facebook URL<input name="facebook_url" value="<%= settings.facebook_url || '' %>"></label><label class="full">About text<textarea name="about_text" rows="5"><%= settings.about_text || '' %></textarea></label><label class="full">Shipping note<textarea name="shipping_note" rows="3"><%= settings.shipping_note || '' %></textarea></label><label class="full">Footer note<textarea name="footer_note" rows="3"><%= settings.footer_note || '' %></textarea></label></div><div class="admin-note">WhatsApp floating button website par tabhi dikhega jab yahan valid WhatsApp number save hoga.</div><button class="admin-btn primary" type="submit">Save Settings</button></form></main><%- include('foot') %>
