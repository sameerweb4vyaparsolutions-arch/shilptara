<%- include('head') %><%- include('sidebar') %><main class="admin-main"><div class="admin-top"><div><small>Catalogue</small><h1><%= product?'Edit Product':'Add Product' %></h1></div><a class="admin-btn" href="/admin/products">← Back</a></div><% if(flash){ %><div class="admin-flash <%= flash.type %>"><%= flash.message %></div><% } %><form class="admin-panel admin-form" method="post" action="/admin/products/save" enctype="multipart/form-data"><input type="hidden" name="id" value="<%= product?.id || '' %>"><div class="form-row"><label>Product Name<input name="name" value="<%= product?.name || '' %>" required></label><label>Category<select name="category_id" required><option value="">Select category</option><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= Number(product?.category_id)===Number(c.id)?'selected':'' %>><%= c.name %></option><% }) %></select></label></div><div class="form-row"><label>Slug<input name="slug" value="<%= product?.slug || '' %>" placeholder="auto-from-name"></label><label>Stock<input type="number" name="stock" min="0" value="<%= product?.stock ?? 0 %>"></label></div><div class="form-row"><label>Price (₹)<input type="number" step="0.01" name="price" value="<%= product?.price || '' %>" required></label><label>Compare Price / MRP (₹)<input type="number" step="0.01" name="compare_price" value="<%= product?.compare_price || '' %>"></label></div><label>Short Description<textarea name="short_description" rows="3"><%= product?.short_description || '' %></textarea></label><label>Full Description<textarea name="description" rows="7"><%= product?.description || '' %></textarea></label><label>Upload Product Images / Videos (multiple)<input type="file" name="images" accept="image/*,video/*" multiple><small>Images and short product videos are supported. Recommended video size: under 20 MB.</small></label><div class="check-row"><label class="check"><input type="checkbox" name="featured" <%= product?.featured?'checked':'' %>> Featured product</label><label class="check"><input type="checkbox" name="active" <%= !product || product.active?'checked':'' %>> Active on website</label></div><button class="admin-btn primary" type="submit">Save Product</button></form><% if(product && images.length){ %><div class="admin-panel"><div class="panel-head"><h2>Product Media</h2><span><%= images.length %> file(s)</span></div><div class="image-manager"><% images.forEach(img=>{ %><article><% if(String(img.mime_type||'').startsWith('video/')){ %><video src="/media/product/<%= img.id %>" controls preload="metadata"></video><% } else { %><img src="/media/product/<%= img.id %>" alt=""><% } %><form method="post" action="/admin/products/<%= product.id %>/images/<%= img.id %>/delete"><button data-confirm="Remove this image?" type="submit">Remove</button></form></article><% }) %></div></div><% } %></main><%- include('foot') %>
