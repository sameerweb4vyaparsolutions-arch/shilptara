<%- include('head') %><%- include('sidebar') %><main class="admin-main"><div class="admin-top"><div><small>Catalogue</small><h1>Categories</h1></div><a class="admin-btn primary" href="/admin/categories/new">+ Add Category</a></div><% if(flash){ %><div class="admin-flash <%= flash.type %>"><%= flash.message %></div><% } %><div class="admin-panel"><div class="table-wrap"><table><thead><tr><th>Image</th><th>Category</th><th>Slug</th><th>Products</th><th>Status</th><th>Actions</th></tr></thead><tbody><% categories.forEach(c=>{ %><tr><td><img class="admin-thumb" src="/media/category/<%= c.id %>" alt="" onerror="this.onerror=null;this.src='/seed-images/<%= c.slug %>/01.jpg';"></td><td><b><%= c.name %></b></td><td><code><%= c.slug %></code></td><td><%= c.product_count %></td><td><%= c.active?'Active':'Hidden' %></td><td class="actions"><a href="/admin/categories/<%= c.id %>/edit">Edit</a><form method="post" action="/admin/categories/<%= c.id %>/delete"><button data-confirm="Delete this category?" type="submit">Delete</button></form></td></tr><% }) %></tbody></table></div></div></main><%- include('foot') %>
