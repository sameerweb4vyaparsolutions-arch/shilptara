<%- include('head') %><%- include('sidebar') %><main class="admin-main"><div class="admin-top"><div><small>Order details</small><h1><%= order.order_number %></h1></div><a class="admin-btn" href="/admin/orders">← Orders</a></div><% if(flash){ %><div class="admin-flash <%= flash.type %>"><%= flash.message %></div><% } %><div class="admin-order-grid"><div><section class="admin-panel"><div class="panel-head"><h2>Items</h2><span><%= items.length %> item(s)</span></div><div class="table-wrap"><table><thead><tr><th>Product</th><th>Price</th><th>Qty</th><th>Total</th></tr></thead><tbody><% items.forEach(i=>{ %><tr><td><b><%= i.product_name %></b></td><td><%= money(i.price) %></td><td><%= i.quantity %></td><td><%= money(i.line_total) %></td></tr><% }) %></tbody></table></div></section><section class="admin-panel"><div class="panel-head"><h2>Customer & Delivery</h2></div><div class="info-grid"><div><span>Name</span><b><%= order.customer_name %></b></div><div><span>Phone</span><b><%= order.phone %></b></div><div><span>Email</span><b><%= order.email %></b></div><div><span>Pincode</span><b><%= order.pincode %></b></div><div style="grid-column:1/-1"><span>Address</span><b><%= order.address_line %>, <%= order.city %>, <%= order.state %></b></div><% if(order.customer_note){ %><div style="grid-column:1/-1"><span>Customer note</span><b><%= order.customer_note %></b></div><% } %></div></section></div><aside><section class="admin-panel"><div class="panel-head"><h2>Order Summary</h2></div><div class="info-grid"><div><span>Subtotal</span><b><%= money(order.subtotal) %></b></div><% if(Number(order.discount||0)>0){ %><div><span>Discount</span><b>-<%= money(order.discount) %></b></div><% } %><div><span>Shipping</span><b><%= money(order.shipping) %></b></div><div><span>Total</span><b><%= money(order.total) %></b></div><div><span>Payment</span><b><%= order.payment_method %></b></div></div></section><form class="admin-panel admin-form" method="post" action="/admin/orders/<%= order.id %>/status"><h2>Update Status</h2><label>Order status<select name="order_status"><% ['placed','confirmed','processing','shipped','delivered','cancelled'].forEach(s=>{ %><option value="<%= s %>" <%= order.order_status===s?'selected':'' %>><%= s %></option><% }) %></select></label><label>Payment status<select name="payment_status"><% ['pending','paid','failed','refunded'].forEach(s=>{ %><option value="<%= s %>" <%= order.payment_status===s?'selected':'' %>><%= s %></option><% }) %></select></label><button class="admin-btn primary" type="submit">Save Status</button></form></aside></div></main><%- include('foot') %>
