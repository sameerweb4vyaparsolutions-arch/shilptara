<%- include('head') %><%- include('sidebar') %><main class="admin-main narrow"><div class="admin-top"><div><small>Celebrity Gallery</small><h1><%= item?'Edit Photo / Video':'Add Photo / Video' %></h1></div><a class="admin-btn" href="/admin/celebrity">← Back</a></div><% if(flash){ %><div class="admin-flash <%= flash.type %>"><%= flash.message %></div><% } %><form class="admin-panel admin-form" method="post" action="/admin/celebrity/save" enctype="multipart/form-data"><input type="hidden" name="id" value="<%= item?.id || '' %>"><label>Title<input name="title" value="<%= item?.title || '' %>" placeholder="Celebrity / event highlight" required></label><label>Caption<textarea name="caption" rows="4" placeholder="Short description shown below the media"><%= item?.caption || '' %></textarea></label><div class="form-row"><label>Sort Order<input type="number" name="sort_order" value="<%= item?.sort_order || 0 %>"></label><label><%= item?'Replace Photo / Video':'Photo / Video' %><input type="file" name="media" accept="image/*,video/*" <%= item?'':'required' %>><small class="upload-help">Image or video, up to 25 MB. MP4/WebM recommended for video.</small></label></div><label class="check"><input type="checkbox" name="active" <%= !item || item.active?'checked':'' %>> Show on website</label><% if(item){ %><div><b>Current media</b><div class="media-preview-large"><% if(String(item.mime_type||'').startsWith('video/')){ %><video src="/media/celebrity/<%= item.id %>" controls preload="metadata"></video><% } else { %><img src="/media/celebrity/<%= item.id %>" alt="<%= item.title %>"><% } %></div></div><% } %><button class="admin-btn primary" type="submit">Save Celebrity Media</button></form></main><%- include('foot') %>
