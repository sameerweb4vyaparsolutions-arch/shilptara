<%- include('head') %><%- include('sidebar') %><main class="admin-main"><div class="admin-top"><div><small>Homepage</small><h1>Banners</h1></div><a class="admin-btn primary" href="/admin/banners/new">+ Add Banner</a></div><% if(flash){ %><div class="admin-flash <%= flash.type %>"><%= flash.message %></div><% } %><div class="banner-admin-grid"><% banners.forEach(b=>{ %><article class="admin-panel banner-admin-card"><% if(b.has_image){ %><img src="/media/banner/<%= b.id %>" alt=""><% } %><div><small>Order <%= b.sort_order %> • <%= b.active?'Active':'Hidden' %></small><h3><%= b.title %></h3><p><%= b.subtitle %></p><div class="actions"><a href="/admin/banners/<%= b.id %>/edit">Edit</a><form method="post" action="/admin/banners/<%= b.id %>/delete"><button data-confirm="Delete this banner?">Delete</button></form></div></div></article><% }) %></div></main><%- include('foot') %>
