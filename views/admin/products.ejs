<%- include('head') %><%- include('sidebar') %><main class="admin-main"><div class="admin-top"><div><small>Catalogue</small><h1>Products</h1></div><a class="admin-btn primary" href="/admin/products/new">+ Add Product</a></div><% if(flash){ %><div class="admin-flash <%= flash.type %>"><%= flash.message %></div><% } %><form class="admin-filter" method="get"><input name="q" placeholder="Search products" value="<%= q %>"><select name="category_id"><option value="">All categories</option><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= Number(categoryId)===Number(c.id)?'selected':'' %>><%= c.name %></option><% }) %></select><button class="admin-btn">Filter</button></form><div class="admin-panel"><div class="table-wrap"><table><thead><tr><th>Image</th><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Status</th><th>Actions</th></tr></thead><tbody><% products.forEach(p=>{ %><tr><td><% if(p.image_id){ %><img class="admin-thumb" src="/media/product/<%= p.image_id %>" alt=""><% } %></td><td><b><%= p.name %></b><small><%= p.slug %></small></td><td><%= p.category_name %></td><td><%= money(p.price) %></td><td><%= p.stock %></td><td><%= p.active?'Active':'Hidden' %><% if(p.featured){ %> • Featured<% } %></td><td class="actions"><a href="/admin/products/<%= p.id %>/edit">Edit</a><form method="post" action="/admin/products/<%= p.id %>/delete"><button data-confirm="Delete this product? Existing orders may prevent deletion." type="submit">Delete</button></form></td></tr><% }) %></tbody></table></div></div></main><%- include('foot') %>
