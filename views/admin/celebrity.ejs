<%- include('head') %><%- include('sidebar') %><main class="admin-main"><div class="admin-top"><div><small>Homepage & Gallery</small><h1>Celebrity Gallery</h1></div><a class="admin-btn primary" href="/admin/celebrity/new">+ Add Photo / Video</a></div><% if(flash){ %><div class="admin-flash <%= flash.type %>"><%= flash.message %></div><% } %><div class="admin-panel admin-note">Use this section only for celebrity/event photos and videos. These items are separate from Products and Customer Reviews. Uploaded files are stored in MySQL so they remain after redeploy.</div><div class="celebrity-admin-grid"><% if(items.length){ items.forEach(item=>{ %><article class="admin-panel celebrity-admin-card"><div class="celebrity-admin-media"><% if(String(item.mime_type||'').startsWith('video/')){ %><video src="/media/celebrity/<%= item.id %>" controls preload="metadata"></video><% } else { %><img src="/media/celebrity/<%= item.id %>" alt="<%= item.title %>"><% } %></div><div class="celebrity-admin-copy"><small>Order <%= item.sort_order %> • <%= item.active?'Visible':'Hidden' %> • <%= String(item.mime_type||'').startsWith('video/')?'Video':'Photo' %></small><h3><%= item.title %></h3><% if(item.caption){ %><p><%= item.caption %></p><% } %><div class="actions"><a href="/admin/celebrity/<%= item.id %>/edit">Edit</a><form method="post" action="/admin/celebrity/<%= item.id %>/toggle"><button type="submit"><%= item.active?'Hide':'Show' %></button></form><form method="post" action="/admin/celebrity/<%= item.id %>/delete"><button data-confirm="Delete this celebrity gallery item?" type="submit">Delete</button></form></div></div></article><% }) } else { %><div class="admin-panel">No celebrity/event media yet. Click <b>Add Photo / Video</b> to create the first item.</div><% } %></div></main><%- include('foot') %>
