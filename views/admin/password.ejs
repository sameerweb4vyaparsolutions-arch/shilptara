<%- include('head') %><%- include('sidebar') %><main class="admin-main narrow"><div class="admin-top"><div><small>Security</small><h1>Change Admin Password</h1></div></div><% if(flash){ %><div class="admin-flash <%= flash.type %>"><%= flash.message %></div><% } %><form class="admin-panel admin-form" method="post" action="/admin/password"><label>Current password<input type="password" name="current_password" required></label><div class="form-row"><label>New password<input type="password" name="new_password" minlength="8" required></label><label>Confirm new password<input type="password" name="confirm_password" minlength="8" required></label></div><button class="admin-btn primary" type="submit">Change Password</button></form></main><%- include('foot') %>
