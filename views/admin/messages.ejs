<%- include('head') %><%- include('sidebar') %><main class="admin-main"><div class="admin-top"><div><small>Enquiries</small><h1>Contact Messages</h1></div></div><% if(messages.length){ messages.forEach(m=>{ %><article class="admin-panel message-card"><header><div><b><%= m.subject || 'Website enquiry' %></b><small><%= m.name %> • <%= m.email %> <%= m.phone ? '• '+m.phone : '' %></small></div><small><%= new Date(m.created_at).toLocaleString('en-IN') %></small></header><p><%= m.message %></p><div class="actions"><a href="mailto:<%= m.email %>?subject=Re:%20<%= encodeURIComponent(m.subject || 'Your Shilptara enquiry') %>">Reply by Email</a><form method="post" action="/admin/messages/<%= m.id %>/delete"><button data-confirm="Delete this message?" type="submit">Delete</button></form></div></article><% }) } else { %><div class="admin-panel">No messages yet.</div><% } %></main><%- include('foot') %>
