<%- include('head') %><%- include('sidebar') %><main class="admin-main narrow"><div class="admin-top"><div><small>Homepage</small><h1><%= banner?'Edit Banner':'Add Banner' %></h1></div><a class="admin-btn" href="/admin/banners">← Back</a></div><form class="admin-panel admin-form" method="post" action="/admin/banners/save" enctype="multipart/form-data"><input type="hidden" name="id" value="<%= banner?.id || '' %>"><label>Title<input name="title" value="<%= banner?.title || '' %>" required></label><label>Subtitle<textarea name="subtitle" rows="4"><%= banner?.subtitle || '' %></textarea></label><div class="form-row"><label>Button Text<input name="cta_text" value="<%= banner?.cta_text || '' %>"></label><label>Button Link<input name="cta_link" value="<%= banner?.cta_link || '' %>" placeholder="/shop?category=pendants"></label></div><div class="form-row"><label>Sort Order<input type="number" name="sort_order" value="<%= banner?.sort_order || 0 %>"></label><label>Banner Image<input type="file" name="image" accept="image/*"></label></div><label class="check"><input type="checkbox" name="active" <%= !banner || banner.active?'checked':'' %>> Active</label><button class="admin-btn primary" type="submit">Save Banner</button></form></main><%- include('foot') %>
