<%- include('head') %><%- include('sidebar') %><main class="admin-main narrow"><div class="admin-top"><div><small>Catalogue</small><h1><%= category?'Edit Category':'Add Category' %></h1></div><a class="admin-btn" href="/admin/categories">← Back</a></div><form class="admin-panel admin-form" method="post" action="/admin/categories/save" enctype="multipart/form-data"><input type="hidden" name="id" value="<%= category?.id || '' %>"><div class="form-row"><label>Category Name<input name="name" value="<%= category?.name || '' %>" required></label><label>Slug<input name="slug" value="<%= category?.slug || '' %>" placeholder="auto-from-name"></label></div><label>Description<textarea name="description" rows="4"><%= category?.description || '' %></textarea></label><div class="form-row"><label>Sort Order<input type="number" name="sort_order" value="<%= category?.sort_order || 0 %>"></label><label>Category Image<input type="file" name="image" accept="image/*"></label></div><label class="check"><input type="checkbox" name="active" <%= !category || category.active?'checked':'' %>> Active</label><button class="admin-btn primary" type="submit">Save Category</button></form></main><%- include('foot') %>
