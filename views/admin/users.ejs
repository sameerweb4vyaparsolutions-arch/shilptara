<%- include('head') %><%- include('sidebar') %><main class="admin-main"><div class="admin-top"><div><small>Accounts</small><h1>Customers & Users</h1></div></div><div class="admin-panel"><div class="table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Role</th><th>Joined</th></tr></thead><tbody><% users.forEach(u=>{ %><tr><td><b><%= u.name %></b></td><td><%= u.email %></td><td><%= u.phone || '—' %></td><td><span class="admin-status"><%= u.role %></span></td><td><%= new Date(u.created_at).toLocaleDateString('en-IN') %></td></tr><% }) %></tbody></table></div></div></main><%- include('foot') %>
