<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin Login | Shilptara</title><link rel="stylesheet" href="/css/admin.css"></head><body class="admin-login-body"><div class="admin-login-card"><img src="/images/logo.jpg" alt="Shilptara"><h1>Admin Login</h1><p>Manage products, orders, banners, customers and website content.</p><% if(flash){ %><div class="admin-flash <%= flash.type %>"><%= flash.message %></div><% } %><form method="post" action="/admin/login"><label>Email<input type="email" name="email" required></label><label>Password<input type="password" name="password" required></label><button class="admin-btn primary" type="submit">Login to Admin</button></form><a href="/">← Back to website</a></div></body></html>
