<%- include('head') %><%- include('sidebar') %><main class="admin-main"><div class="admin-top"><div><small>Sales</small><h1>Orders</h1></div></div><% if(flash){ %><div class="admin-flash <%= flash.type %>"><%= flash.message %></div><% } %><div class="admin-panel"><div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Contact</th><th>Total</th><th>Payment</th><th>Status</th><th>Date</th><th></th></tr></thead><tbody><% if(orders.length){ orders.forEach(o=>{ %><tr><td><b><%= o.order_number %></b></td><td><%= o.customer_name %></td><td><%= o.phone %><small><%= o.email %></small></td><td><%= money(o.total) %></td><td><%= o.payment_method %> • <%= o.payment_status %></td><td><span class="admin-status"><%= o.order_status %></span></td><td><%= new Date(o.created_at).toLocaleDateString('en-IN') %></td><td><a class="admin-btn" href="/admin/orders/<%= o.id %>">View</a></td></tr><% }) } else { %><tr><td colspan="8">No orders yet.</td></tr><% } %></tbody></table></div></div></main><%- include('foot') %>
