<%- include('partials/header') %><main class="auth-page"><section class="auth-card"><span class="section-kicker">Join Shilptara</span><h1>Create Account</h1><p>Save details, place orders and review your favourites.</p><form method="post" action="/register"><label>Name<input class="field" name="name" required></label><label>Email<input class="field" type="email" name="email" required></label><label>Phone<input class="field" name="phone"></label><label>Password<input class="field" type="password" name="password" minlength="6" required></label><button class="btn btn-primary btn-block" type="submit">Create Account</button></form><p class="auth-switch">Already have an account? <a href="/login">Login</a></p></section></main><%- include('partials/footer') %>
