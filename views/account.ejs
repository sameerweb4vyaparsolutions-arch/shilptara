<%- include('partials/header') %><main class="page-main"><section class="page-hero mini"><div class="container"><h1>Hello, <%= currentUser.name %></h1><p>View your recent orders and account activity.</p></div></section><section class="section container"><div class="section-heading split"><div><span class="section-kicker">My Account</span><h2>Orders</h2></div><form method="post" action="/logout"><button class="btn btn-ghost" type="submit">Logout</button></form></div><div class="table-wrap"><table class="site-table"><thead><tr><th>Order</th><th>Date</th><th>Status</th><th>Payment</th><th>Total</th></tr></thead><tbody><% if(orders.length){ orders.forEach(o=>{ %><tr><td><b><%= o.order_number %></b></td><td><%= new Date(o.created_at).toLocaleDateString('en-IN') %></td><td><span class="status-pill"><%= o.order_status %></span></td><td><%= o.payment_status %></td><td><%= money(o.total) %></td></tr><% }) } else { %><tr><td colspan="5">No orders yet.</td></tr><% } %></tbody></table></div></section></main><%- include('partials/footer') %>
