<%- include('partials/header') %><main class="page-main"><section class="page-hero mini"><div class="container"><h1>Checkout</h1><p>Enter delivery details and review your order.</p></div></section><section class="container checkout-layout"><form class="checkout-form" method="post" action="/checkout"><div class="form-card"><h2>Contact & Delivery</h2><div class="form-grid two"><label>Full name<input class="field" name="customer_name" value="<%= profile?.name || '' %>" required></label><label>Email<input class="field" type="email" name="email" value="<%= profile?.email || '' %>" required></label><label>Phone<input class="field" name="phone" value="<%= profile?.phone || '' %>" required></label><label>Pincode<input class="field" name="pincode" required></label><label class="span-2">Address<textarea class="field" name="address_line" rows="3" required></textarea></label><label>City<input class="field" name="city" required></label><label>State<input class="field" name="state" required></label><label class="span-2">Order note (optional)<textarea class="field" name="customer_note" rows="3" placeholder="Customisation note, landmark, gifting note..."></textarea></label></div></div><div class="form-card"><h2>Payment</h2><label class="payment-option active"><input type="radio" name="payment_method" value="COD" checked><span><b>Cash on Delivery</b><small>Pay when the order arrives.</small></span></label><label class="payment-option"><input type="radio" name="payment_method" value="ONLINE"><span><b>Online Payment</b><small>Integration-ready. Enable payment gateway before live use.</small></span></label></div><button class="btn btn-primary btn-block btn-lg" type="submit">Place Order • <%= money(total) %></button></form><aside class="order-summary checkout-summary"><h2>Your Order</h2><% items.forEach(i=>{ %><div class="checkout-item"><img src="/media/product/<%= i.image_id %>" alt=""><span><b><%= i.name %></b><small>Qty <%= i.qty %></small></span><strong><%= money(i.line_total) %></strong></div><% }) %><hr><div><span>Subtotal</span><b><%= money(subtotal) %></b></div><% if(discount>0){ %><div><span>Discount (<%= couponCode %>)</span><b>-<%= money(discount) %></b></div><% } %><div><span>Shipping</span><b><%= shipping===0?'FREE':money(shipping) %></b></div><div class="summary-total"><span>Total</span><b><%= money(total) %></b></div></aside></section></main><%- include('partials/footer') %>
