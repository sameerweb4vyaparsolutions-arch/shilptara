<%- include('partials/header') %>
<main class="page-main">
  <section class="container product-detail">
    <div class="product-gallery">
      <div class="gallery-main"><% if(images.length){ %><img data-main-product-img src="/media/product/<%= images[0].id %>" alt="<%= product.name %>"><% if(images.length>1){ %><div class="gallery-nav"><button type="button" data-gallery-nav="prev" aria-label="Previous image">←</button><button type="button" data-gallery-nav="next" aria-label="Next image">→</button></div><% } %><% } %></div>
      <% if(images.length>1){ %><div class="gallery-thumbs"><% images.forEach((img,i)=>{ %><button class="<%= i===0?'active':'' %>" type="button" data-gallery-src="/media/product/<%= img.id %>"><img src="/media/product/<%= img.id %>" alt=""></button><% }) %></div><% } %>
    </div>
    <div class="product-info">
      <div class="breadcrumb"><a href="/">Home</a> / <a href="/shop?category=<%= product.category_slug %>"><%= product.category_name %></a></div>
      <div class="product-title-row"><h1><%= product.name %></h1><button class="share-btn" type="button" data-share-product title="Share">↗</button></div>
      <div class="rating-line large"><span>★★★★★</span><small><%= product.avg_rating || 'New' %> <%= product.review_count ? '('+product.review_count+' reviews)' : '' %></small></div>
      <div class="detail-price"><strong><%= money(product.price) %></strong><% if(product.compare_price && Number(product.compare_price)>Number(product.price)){ %><del><%= money(product.compare_price) %></del><span><%= Math.round((1-Number(product.price)/Number(product.compare_price))*100) %>% OFF</span><% } %></div>
      <p class="product-short"><%= product.short_description %></p>
      <div class="mini-benefits"><span>🌿 Real botanical detail</span><span>🎁 Gift-ready</span><span>✦ Handmade</span></div>
      <form class="buy-box" method="post" action="/cart/add">
        <input type="hidden" name="product_id" value="<%= product.id %>">
        <div class="qty-row"><label>Quantity</label><div class="qty-control"><button type="button" data-qty-minus>−</button><input name="qty" type="number" min="1" max="10" value="1" data-qty-input><button type="button" data-qty-plus>+</button></div><span class="stock <%= product.stock>0?'':'out' %>"><%= product.stock>0 ? product.stock+' available' : 'Made to order / out of stock' %></span></div>
        <button class="btn btn-dark btn-block" type="submit">Add to Cart</button>
      </form>
      <form method="post" action="/buy-now"><input type="hidden" name="product_id" value="<%= product.id %>"><input type="hidden" name="qty" value="1" data-buy-now-qty><button class="btn btn-primary btn-block" type="submit">Buy It Now</button></form>
      <form method="post" action="/wishlist/toggle"><input type="hidden" name="product_id" value="<%= product.id %>"><button class="btn btn-ghost btn-block" type="submit"><%= inWishlist?'♥ Remove from Wishlist':'♡ Add to Wishlist' %></button></form>
      <div class="product-accordions">
        <details open><summary>Product Description</summary><p><%= product.description %></p><p>Because real botanicals are used, colour, shape and placement may vary slightly from the photographs. That natural variation makes every handmade piece one of a kind.</p></details>
        <details><summary>Care & Shipping</summary><p>Keep resin pieces away from harsh chemicals and extreme heat. Store jewellery dry when not in use. Shipping is calculated at checkout and custom products may require additional making time.</p></details>
        <details><summary>Customisation</summary><p>Want a name, date, different flower colour or a custom memory preserved? Use the “Ask a Question” form below or contact us on WhatsApp.</p></details>
      </div>
    </div>
  </section>

  <section class="container detail-lower-grid">
    <div class="reviews-panel"><div class="section-heading split"><div><span class="section-kicker">Customer feedback</span><h2>Reviews</h2></div><span><%= reviews.length %> review(s)</span></div>
      <% if(reviews.length){ %><div class="review-list"><% reviews.forEach(r=>{ %><article><div class="stars"><%= '★'.repeat(r.rating) %></div><p><%= r.comment %></p><strong><%= r.reviewer_name %></strong></article><% }) %></div><% } else { %><p>No reviews yet. Be the first to review this piece.</p><% } %>
      <% if(currentUser){ %><form class="form-card" method="post" action="/product/<%= product.id %>/review"><h3>Write a review</h3><select class="field" name="rating"><option value="5">5 stars</option><option value="4">4 stars</option><option value="3">3 stars</option><option value="2">2 stars</option><option value="1">1 star</option></select><textarea class="field" name="comment" rows="4" required placeholder="Tell us what you liked"></textarea><button class="btn btn-primary" type="submit">Submit Review</button></form><% } else { %><a href="/login" class="text-link">Login to write a review →</a><% } %>
    </div>
    <div class="question-panel"><span class="section-kicker">Need help?</span><h2>Ask a Question</h2><p>Ask about customisation, dimensions, flowers, gifting or delivery.</p><form class="form-card" method="post" action="/product/<%= product.id %>/question"><input class="field" name="name" value="<%= currentUser?.name || '' %>" placeholder="Your name" required><input class="field" type="email" name="email" value="<%= currentUser?.email || '' %>" placeholder="Email" required><textarea class="field" name="question" rows="5" placeholder="Your question" required></textarea><button class="btn btn-dark" type="submit">Ask Question</button></form>
      <% if(questions.length){ %><div class="faq-list"><% questions.forEach(q=>{ %><details><summary><%= q.question %></summary><p><%= q.answer %></p></details><% }) %></div><% } %>
    </div>
  </section>
  <% if(related.length){ %><section class="section soft-bg"><div class="container"><div class="section-heading split"><div><span class="section-kicker">More to explore</span><h2>You may also like</h2></div><a href="/shop?category=<%= product.category_slug %>">View category →</a></div><div class="product-grid"><% related.slice(0,4).forEach(product=>{ %><%- include('partials/product-card',{product}) %><% }) %></div></div></section><% } %>
</main>
<%- include('partials/footer') %>
